    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.0.17",
    "jsdom": "^27.0.0",
    "msw": "^2.12.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.17"
