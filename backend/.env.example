DATABASE_URL=postgresql+psycopg://carrier_pool:carrier_pool@localhost:5432/carrier_pool?sslmode=require
DEMO_MODE=false
AUTH_MODE=oidc
ALLOW_MOCK_AUTH=false
AUTH_SECRET=
AUTH_ISSUER=https://your-issuer.example/
AUTH_AUDIENCE=carrier-pool-api
AUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
AUTH_LOGIN_URL=https://your-issuer.example/authorize
AUTH_TOKEN_URL=https://your-issuer.example/oauth/token
AUTH_CLIENT_ID=carrier-pool
AUTH_REDIRECT_URI=https://app.example.com/login
AUTH_TENANT_CLAIM=tenant_id
ALLOWED_HOSTS=app.example.com
AUTH_TOKEN_TTL_SECONDS=3600
# Keep false unless the configured OIDC provider and shared-pool secret are ready.
SHARED_POOL_READ_ENABLED=false
# Required only when the guarded shared-pool read path is enabled.
SHARED_POOL_ID_SECRET=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
INGESTION_MAX_FILE_BYTES=10485760
INGESTION_MAX_RECORDS=1000
