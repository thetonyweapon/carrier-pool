DATABASE_URL=postgresql+psycopg://carrier_pool:carrier_pool@localhost:5432/carrier_pool
DEMO_MODE=false
AUTH_MODE=mock
ALLOW_MOCK_AUTH=false
AUTH_SECRET=
AUTH_ISSUER=carrier-pool-mock
AUTH_AUDIENCE=carrier-pool-api
AUTH_TOKEN_TTL_SECONDS=3600
# Keep false until authenticated broker identity is available.
SHARED_POOL_READ_ENABLED=false
# Required only when the guarded shared-pool read path is enabled.
SHARED_POOL_ID_SECRET=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
INGESTION_MAX_FILE_BYTES=10485760
INGESTION_MAX_RECORDS=1000
